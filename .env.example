OPENAI_API_KEY=sk-your-key-here
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Leave empty to run Qdrant embedded (no Docker); docker-compose sets it to http://qdrant:6333
QDRANT_URL=
QDRANT_PATH=./qdrant_data
COLLECTION=docs

PDF_DIR=./data/pdfs
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
SCORE_THRESHOLD=0.3
